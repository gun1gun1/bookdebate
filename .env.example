# 실제 값은 절대 커밋하지 않는다. 각 값의 위치는 Phase 1 종료 안내 참고.

# Supabase 프로젝트 URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# service-role 키 (Project Settings > API > Project API keys > service_role)
# 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 공유 문구 생성 등에 쓰는 절대 URL. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 아래는 Phase 2(인증)에서 쓰인다 ---

# 공통 암호의 bcrypt 해시. scripts/hash-password.ts로 생성한다.
SITE_PASSWORD_HASH=

# 세션 JWT 서명 키. 32자 이상 랜덤 문자열.
SESSION_SECRET=

# 개인 PIN 추가 인증 사용 여부. 기본 false.
REQUIRE_MEMBER_PIN=false

# --- 아래는 Phase 5(keep-alive cron)에서 쓰인다 ---

CRON_SECRET=
